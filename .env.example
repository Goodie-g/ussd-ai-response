PORT=3000

# AI provider: gemini | openai | none  (none = keyword matching only, still works)
AI_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# USSD sessions are short-lived: if the AI is slower than this, we fall back
AI_TIMEOUT_MS=3500

# Comma-separated provider ids from src/apis/index.js
PRICE_PROVIDERS=mock
PROVIDER_TIMEOUT_MS=3000
CACHE_TTL_SECONDS=600
